# Copy this file's content into Vercel Project Settings -> Environment
# Variables (not into a committed .env file). Generate a long random value,
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

API_KEY=

# Optional — only needed for /api/voltfuscator/obfuscate. This is YOUR OWN
# Voltfuscator account key from https://voltils.cc/dashboard/, separate
# from API_KEY above. You can skip this and send `voltKey` per-request
# instead if you'd rather not share one account across every caller.
VOLTFUSCATOR_API_KEY=

# Optional — only for /api/nova/obfuscate's "premium" level. The original
# Nova app hard-codes a leaked key to gate this; we don't ship that secret.
# Leave blank to let "premium" behave like any other level (gated only by
# this gateway's own API_KEY). Set it to require an extra `novaKey` on top.
NOVA_PREMIUM_KEY=
